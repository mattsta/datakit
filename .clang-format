# Project formatting: the persistent form of the `form` wrapper
# (clang-format, LLVM base). With this file present, plain
# `clang-format -i <files>` and editor/CI integrations all pick up the
# project style automatically; `dktools format` runs it on every C
# source and header outside deps/.
BasedOnStyle: LLVM
IndentWidth: 4
AllowShortFunctionsOnASingleLine: None
KeepEmptyLinesAtTheStartOfBlocks: false
InsertBraces: true
InsertNewlineAtEOF: true
