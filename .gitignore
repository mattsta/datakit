build*
# `build*` above is for build directories; don't let it swallow docs.
!docs/BUILD_PRESETS.md
compile_commands.json

# Internal working material (plans, designs, audits, session notes,
# scratch). Never committed; docs/ holds only the curated public docs.
# Promote a file by moving it into docs/ and committing it explicitly.
notes/

# Per-developer prettier config (references local-only directories).
.prettierignore

/src/old
/src/Testing
/Testing
CMakeFiles


# Per-developer clangd LSP config (machine-specific SDK paths etc.).
# Copy .clangd.sample to .clangd and customize; do not commit.
.clangd

# Upstream xxHash's test suite, CLI, fuzzers and CI configuration are
# not vendored (datakit builds only the library); a local upstream
# clone of deps/xxHash still has them on disk.
/deps/xxHash/tests/
/deps/xxHash/cli/
/deps/xxHash/fuzz/
/deps/xxHash/.github/
